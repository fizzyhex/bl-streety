<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Streety</RootNamespace>
    <AssemblyName>Streety</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DefineConstants>$(DefineConstants);MELONLOADER</DefineConstants>
    <!-- copy to the game on build; set to false for CI -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableBonelabMcpAdapter)' == 'true'">
    <DefineConstants>$(DefineConstants);BONELAB_MCP_ADAPTER</DefineConstants>
    <BonelabMcpRoot Condition="'$(BonelabMcpRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\bonelab-mcp</BonelabMcpRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableBonelabMcpAdapter)' == 'true'">
    <ProjectReference Include="$(BonelabMcpRoot)\src\BonelabMcp.Contracts\BonelabMcp.Contracts.csproj" Private="false" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="MelonLoader" HintPath="$(MelonNet6)\MelonLoader.dll" />
    <Reference Include="0Harmony" HintPath="$(MelonNet6)\0Harmony.dll" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(MelonNet6)\Il2CppInterop.Runtime.dll" />
    <Reference Include="Il2CppInterop.Common" HintPath="$(MelonNet6)\Il2CppInterop.Common.dll" />

    <Reference Include="Il2Cppmscorlib" HintPath="$(Il2CppAssemblies)\Il2Cppmscorlib.dll" />
    <Reference Include="Il2CppSystem" HintPath="$(Il2CppAssemblies)\Il2CppSystem.dll" />
    <Reference Include="Assembly-CSharp" HintPath="$(Il2CppAssemblies)\Assembly-CSharp.dll" />
    <Reference Include="Il2CppSLZ.Marrow" HintPath="$(Il2CppAssemblies)\Il2CppSLZ.Marrow.dll" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(Il2CppAssemblies)\Unity.TextMeshPro.dll" />
    <Reference Include="UnityEngine.UI" HintPath="$(Il2CppAssemblies)\UnityEngine.UI.dll" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(Il2CppAssemblies)\UnityEngine.UIModule.dll" />
    <Reference Include="UnityEngine" HintPath="$(Il2CppAssemblies)\UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Il2CppAssemblies)\UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(Il2CppAssemblies)\UnityEngine.PhysicsModule.dll" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(Il2CppAssemblies)\UnityEngine.AudioModule.dll" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(Il2CppAssemblies)\UnityEngine.ImageConversionModule.dll" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(Il2CppAssemblies)\UnityEngine.TextRenderingModule.dll" />
    <Reference Include="Unity.RenderPipelines.Universal.Runtime" HintPath="$(Il2CppAssemblies)\Unity.RenderPipelines.Universal.Runtime.dll" />

    <Reference Include="BoneLib" HintPath="$(BONELAB_DIR)\Mods\BoneLib.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\native\draco\dracodec_unity.dll" Link="dracodec_unity.dll" Condition="Exists('..\..\native\draco\dracodec_unity.dll')" />
  </ItemGroup>

  <!-- fail early with a readable message instead of a wall of missing-reference errors -->
  <Target Name="CheckBonelabDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(BONELAB_DIR)' == ''" Text="BONELAB_DIR isn't set. set it to your bonelab install folder (user env var), then restart your ide." />
    <Error Condition="'$(BONELAB_DIR)' != '' And !Exists('$(MelonNet6)\MelonLoader.dll')" Text="no melonloader found under BONELAB_DIR ($(BONELAB_DIR)). check the path, and that melonloader has run at least once." />
  </Target>

  <!-- copies the built mod into $(BONELAB_DIR)\Mods; pass -p:DeployToGame=false to skip -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <ItemGroup>
      <_DeployModFiles Include="$(TargetPath)" />
      <_DeployModFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <_DeployUserLibs Include="..\..\native\draco\dracodec_unity.dll" Condition="Exists('..\..\native\draco\dracodec_unity.dll')" />
    </ItemGroup>
    <Warning Condition="!Exists('$(BONELAB_DIR)')" Text="skipping deploy: BONELAB_DIR ($(BONELAB_DIR)) doesn't exist." />
    <MakeDir Directories="$(BonelabModsDir);$(BonelabUserLibsDir)" Condition="Exists('$(BONELAB_DIR)')" />
    <!-- a running game locks the dll; warn rather than fail so the build still succeeds -->
    <Copy SourceFiles="@(_DeployModFiles)" DestinationFolder="$(BonelabModsDir)" SkipUnchangedFiles="true" Retries="3" RetryDelayMilliseconds="500" ContinueOnError="WarnAndContinue" Condition="Exists('$(BONELAB_DIR)')">
      <Output TaskParameter="CopiedFiles" ItemName="_DeployedFiles" />
    </Copy>
    <Copy SourceFiles="@(_DeployUserLibs)" DestinationFolder="$(BonelabUserLibsDir)" SkipUnchangedFiles="true" Retries="3" RetryDelayMilliseconds="500" ContinueOnError="WarnAndContinue" Condition="Exists('$(BONELAB_DIR)')">
      <Output TaskParameter="CopiedFiles" ItemName="_DeployedFiles" />
    </Copy>
    <Message Importance="high" Text="$(TargetName) -&gt; $(BonelabModsDir)" Condition="'@(_DeployedFiles)' != ''" />
  </Target>

</Project>
