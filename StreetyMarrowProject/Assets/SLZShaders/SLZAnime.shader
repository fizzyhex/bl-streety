			//#if _ALBEDOMULTIPLY_ON
				float4 albedo = float4(_BaseMap.SampleLevel(sampler_BaseMap, vInterpolated.texcoord.xy * _BaseMap_ST.xy + _BaseMap_ST.zw, 0 ).rgb , 1) ;
			// #else
			// 	float4 albedo = float4(1,1,1,1);
			// #endif

